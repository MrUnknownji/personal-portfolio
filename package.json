    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "server-only": "0.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "lighthouse": "13.4.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
